# Modèle : copier ce fichier en application-secret.properties (non suivi par Git)
# et renseigner les valeurs réelles. Ne jamais committer le fichier rempli.

# Clé AES de chiffrement du mot de passe SMTP (exactement 32 caractères)
mail.encryption.key=CHANGER_CETTE_CLE_DE_32_CARACTERE

# Base de données
spring.datasource.password=CHANGER

# Compte de service Active Directory
ldap.password=CHANGER

# Mot de passe des comptes de test (profil dev uniquement)
app.auth.test-login.password=CHANGER
